<Page
    x:Class="YolanLive.WinUI.BaseFramePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YolanLive.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winui="using:Microsoft.UI.Xaml.Controls"
    
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarGrid" Background="{ThemeResource ChromeSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BtnBack"
                Width="56"
                Height="32"
                Margin="0"
                Background="Transparent"
                BorderBrush="Transparent">
                <FontIcon
                    FontFamily="{StaticResource SegoeFluent}"
                    FontSize="16"
                    Glyph="&#xE112;" />
            </Button>
            <Grid
                x:Name="TitleBar"
                Grid.Column="1"
                Height="32"
                Background="#00FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="AppIcon"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    Margin="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
                <Grid Grid.Column="1" Margin="0,0,138,0" Background="#00FFFFFF">
                    <TextBlock
                        x:Name="Title"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BrandFontFamily}"
                        CharacterSpacing="35"
                        FontSize="{StaticResource BrandTextSize}"
                        LineHeight="{StaticResource BrandLineHeight}"
                        FontWeight="Normal"
                        ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                        TextTrimming="CharacterEllipsis"
                        Text=""
                        Visibility="Collapsed" />
                </Grid>

            </Grid>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" />
        <Grid
            x:Name="TitleBar2"
            Height="32"
            Background="#00FFFFFF"
            Visibility="Collapsed" />
    </Grid>
</Page>
