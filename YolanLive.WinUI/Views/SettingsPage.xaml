<?xml version="1.0" ?><Page xmlns:design="using:YolanLive.WinUI.Helper" x:Class="YolanLive.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:YolanLive.WinUI.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="using:Microsoft.UI.Xaml.Controls" mc:Ignorable="d" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}">
    <Page.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Page.Resources>
    <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}" Margin="0,0,0,12">
            <Grid x:Name="BrowseHeader" MinHeight="72" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleStyle}" Text="设置"/><AutoSuggestBox x:Name="HeaderSearch" Grid.Column="2" design:PageDesign.Search="True" Style="{StaticResource BrowseSearchStyle}" Width="240" PlaceholderText="全平台搜索或粘贴链接" QueryIcon="Find"/><Button x:Name="CompactSearch" Grid.Column="2" Style="{StaticResource ToolbarIconStyle}" Visibility="Collapsed" ToolTipService.ToolTip="全平台搜索" AutomationProperties.Name="全平台搜索" design:PageDesign.CompactSearch="True"><SymbolIcon Symbol="Find"/></Button><StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal"/></Grid>
        </TitleBar>
        <ScrollViewer Grid.Row="1">
            <Grid Margin="0" HorizontalAlignment="Stretch">
                <StackPanel x:Name="SettingsCards" MaxWidth="1040" HorizontalAlignment="Stretch">
                    <TextBlock Margin="0,0,0,12" Style="{StaticResource SectionTitleStyle}">常规</TextBlock>
                    <Border x:Name="SettingsGeneralGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">窗口大小</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" TextWrapping="Wrap" Foreground="{ThemeResource ReadableSecondaryTextBrush}">按 16:9 视频区域调整播放窗口；工具栏高度另计</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbWindowSize" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}"/>
                    </Grid>
                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">显示模式</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">切换深色与浅色模式</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbTheme" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}">
                            <ComboBox.Items>
                                <ComboBoxItem>跟随系统</ComboBoxItem>
                                <ComboBoxItem>浅色</ComboBoxItem>
                                <ComboBoxItem>深色</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    <Grid x:Name="SettingsPaneDiaplsyMode" Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">导航栏位置</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">首页导航栏位置</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbPaneDisplayMode" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}">
                            <ComboBox.Items>
                                <ComboBoxItem>左侧</ComboBoxItem>
                                <ComboBoxItem>顶部</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>
                    <Grid x:Name="SettingsMouseClosePage" Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">鼠标侧键返回</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">按鼠标侧键返回上一页</TextBlock>
                        </StackPanel>
                        <ToggleSwitch x:Name="swMouseClosePage" MinWidth="72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>


                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,24,0,12" Style="{StaticResource SectionTitleStyle}">播放</TextBlock>
                    <Border x:Name="SettingsPlaybackGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid x:Name="SettingsNewWindow" Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">新窗口播放</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">使用新窗口打开直播间</TextBlock>
                        </StackPanel>
                        <ToggleSwitch x:Name="swNewWindow" MinWidth="72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}">视频解码器</TextBlock>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">播放失败可尝试修改此选项</TextBlock>
                        </StackPanel>
                        <ComboBox x:Name="cbDecoder" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}">
                            <ComboBox.Items>
                                <ComboBoxItem>自动</ComboBoxItem>
                                <ComboBoxItem>硬件解码</ComboBoxItem>
                                <ComboBoxItem>软件解码</ComboBoxItem>
                            </ComboBox.Items>
                        </ComboBox>
                    </Grid>

                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,24,0,12" Style="{StaticResource SectionTitleStyle}">账号</TextBlock>
                    <Border x:Name="SettingsAccountsGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/bilibili.png"/>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Style="{StaticResource BodyTextStyle}">哔哩哔哩</TextBlock>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" x:Name="txtBili" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                    登录后可享受高清直播
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="BtnLoginBili" HorizontalAlignment="Right" Click="BtnLoginBili_Click" Style="{StaticResource PageActionButtonStyle}">
                            登录
                        </Button>
                        <Button x:Name="BtnLogoutBili" HorizontalAlignment="Right" Click="BtnLogoutBili_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}">
                            退出登录
                        </Button>
                    </Grid>

                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/douyin.png"/>
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Style="{StaticResource BodyTextStyle}">抖音</TextBlock>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" x:Name="txtDouyin" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="未登录，可浏览游戏直播"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnLoginDouyin" HorizontalAlignment="Right" Click="BtnLoginDouyin_Click" Style="{StaticResource PageActionButtonStyle}">登录</Button>
                        <Button x:Name="BtnLogoutDouyin" HorizontalAlignment="Right" Click="BtnLogoutDouyin_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}">退出登录</Button>
                    </Grid>

                    <Grid x:Name="SettingsHuya" Padding="16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/huya.png"/><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Style="{StaticResource BodyTextStyle}" Text="虎牙"/><TextBlock Style="{StaticResource SecondaryTextStyle}" x:Name="txtHuya" Text="未登录，可浏览游戏直播" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="BtnLoginHuya" Content="登录" Tag="Huya" Click="BtnLoginWeb_Click" Style="{StaticResource PageActionButtonStyle}"/><Button x:Name="BtnLogoutHuya" Content="退出登录" Tag="Huya" Click="BtnLogoutWeb_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}"/></StackPanel>
                            </Grid>
                    <Grid x:Name="SettingsDouyu" Padding="16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="36" Height="36" Margin="0,0,12,0" Source="/Assets/Logo/douyu.png"/><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock Style="{StaticResource BodyTextStyle}" Text="斗鱼"/><TextBlock Style="{StaticResource SecondaryTextStyle}" x:Name="txtDouyu" Text="未登录，可浏览游戏直播" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" TextWrapping="Wrap"/></StackPanel></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="BtnLoginDouyu" Content="登录" Tag="Douyu" Click="BtnLoginWeb_Click" Style="{StaticResource PageActionButtonStyle}"/><Button x:Name="BtnLogoutDouyu" Content="退出登录" Tag="Douyu" Click="BtnLogoutWeb_Click" Visibility="Collapsed" Style="{StaticResource PageActionButtonStyle}"/></StackPanel>
                            </Grid>
                    </StackPanel>
                    </Border>
                    <TextBlock Margin="0,24,0,12" Style="{StaticResource SectionTitleStyle}">关于</TextBlock>
                    <Border x:Name="SettingsAboutGroup" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardOutlineBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                    <Grid Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BrandTextStyle}" x:Name="AboutAppName" FontFamily="{StaticResource BrandFontFamily}" FontSize="18" FontWeight="Normal" Text="{StaticResource AppDisplayName}"/>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="YolanLive"/>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                版本:<Run x:Name="version"/></TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button x:Name="BtnLog" Margin="8,0" Click="BtnLog_Click" Style="{StaticResource PageActionButtonStyle}">
                                运行日志
                            </Button>
                            <Button x:Name="BtnGithub" Click="BtnGithub_Click" Style="{StaticResource PageActionButtonStyle}">项目主页</Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="SettingsUpdate" Padding="16" Background="{ThemeResource SystemControlTransparentBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="软件更新"/>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="{x:Bind updateVM.Status, Mode=OneWay}"/>
                            <ProgressBar x:Name="UpdateProgress" Height="4" Maximum="100" Value="{x:Bind updateVM.Progress, Mode=OneWay}" Visibility="{x:Bind updateVM.HideProgress, Mode=OneWay, Converter={StaticResource displayConvert}}" AutomationProperties.Name="安装包下载进度"/>
                        </StackPanel>
                        <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button x:Name="BtnCheckUpdate" Content="检测更新" Click="BtnCheckUpdate_Click" IsEnabled="{x:Bind updateVM.CanCheck, Mode=OneWay}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnDownloadUpdate" Content="{x:Bind updateVM.DownloadButtonText, Mode=OneWay}" Click="BtnDownloadUpdate_Click" Visibility="{x:Bind updateVM.HideDownload, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnInstallUpdate" Content="启动安装器并退出" Click="BtnInstallUpdate_Click" Visibility="{x:Bind updateVM.HideInstall, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                            <Button x:Name="BtnCancelUpdate" Content="取消" Click="BtnCancelUpdate_Click" Visibility="{x:Bind updateVM.HideCancel, Mode=OneWay, Converter={StaticResource displayConvert}}" Style="{StaticResource PageActionButtonStyle}"/>
                        </StackPanel><StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind updateVM.HideRecovery, Mode=OneWay, Converter={StaticResource displayConvert}}"><Button x:Name="BtnBrowserUpdate" Content="{x:Bind updateVM.BrowserActionText, Mode=OneWay}" Click="BtnBrowserUpdate_Click" Style="{StaticResource PageActionButtonStyle}"/><Button x:Name="BtnCopyUpdate" Content="{x:Bind updateVM.CopyActionText, Mode=OneWay}" Click="BtnCopyUpdate_Click" Style="{StaticResource PageActionButtonStyle}"/></StackPanel></StackPanel>
                    </Grid>


                    </StackPanel>
                    </Border>
                                    </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>