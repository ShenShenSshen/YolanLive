<?xml version="1.0" ?><Page xmlns:design="using:YolanLive.WinUI.Helper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:YolanLive.WinUI.Controls" xmlns:viewModels="using:YolanLive.WinUI.ViewModels" x:Class="YolanLive.WinUI.Views.RecomendPage" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}">
 <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16" Spacing="12">
 <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}"><Grid x:Name="BrowseHeader" MinHeight="72" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CompactPageTitle" Text="首页" Style="{StaticResource PageTitleStyle}" Visibility="Collapsed"/><Border x:Name="PlatformSurface" Padding="4" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="12" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource BrowsingOutlineBrush}" BorderThickness="0">
 <ListView x:Name="PlatformPicker" Padding="0" ItemsSource="{x:Bind viewModels:MainVM.Sites}" SelectionChanged="PlatformPicker_SelectionChanged" SelectionMode="Single" IsMultiSelectCheckBoxEnabled="False" HorizontalAlignment="Left" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource PlatformTabStyle}" AutomationProperties.Name="直播平台">
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="96" ItemHeight="44"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource NavigationTextStyle}" Text="{Binding Label}" FontSize="{StaticResource BodyTextSize}" Margin="0" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="20" FontFamily="{StaticResource NavigationFontFamily}"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </Border><AutoSuggestBox x:Name="HeaderSearch" Grid.Column="2" design:PageDesign.Search="True" Style="{StaticResource BrowseSearchStyle}" Width="240" PlaceholderText="搜索主播或粘贴链接" QueryIcon="Find" AutomationProperties.Name="搜索主播或直播链接"/><Button x:Name="HeaderRefresh" IsEnabled="{x:Bind recomendVM.CanRefresh, Mode=OneWay}" Grid.Column="3" Margin="0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind recomendVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><Grid><FontIcon Visibility="{x:Bind recomendVM.CanRefresh, Mode=OneWay}" FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/><ProgressRing Width="16" Height="16" IsActive="{x:Bind recomendVM.Loading, Mode=OneWay}" Visibility="{x:Bind recomendVM.Loading, Mode=OneWay}"/></Grid></Button></Grid></TitleBar>
 <Border x:Name="PlatformOverflowHost" Visibility="Collapsed" HorizontalAlignment="Left"/>
 <StackPanel x:Name="PinnedGamesSection" Visibility="Collapsed" Spacing="4">
 <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="常看游戏" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}"/>
 <ListView x:Name="PinnedGamesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PinnedGamesList_ItemClick" ContainerContentChanging="PinnedGamesList_ContainerContentChanging" Padding="0" AutomationProperties.Name="常看游戏" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
 <ListView.Resources><CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius></ListView.Resources>
 <ListView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="160"/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,8,4"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
 <ListView.ItemTemplate><DataTemplate><Border CornerRadius="8" Padding="12,8" BorderThickness="1" BorderBrush="{ThemeResource BrowsingOutlineBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}" ToolTipService.ToolTip="{Binding Name}"><TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextAlignment="Center"/></Border></DataTemplate></ListView.ItemTemplate>
 </ListView>
 </StackPanel>
 </StackPanel>
 <controls:MyAdaptiveGridView x:Name="RoomsGrid" Grid.Row="2" Padding="0" Margin="-8,0,-8,-8" CanLoadMore="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}" DataLoading="{x:Bind recomendVM.Loading, Mode=OneWay}" DesiredWidth="{StaticResource GridViewDesiredWidth}" IsItemClickEnabled="True" ItemClick="MyAdaptiveGridView_ItemClick" ItemHeight="{StaticResource GridViewItemHeight}" ItemTemplate="{StaticResource RoomItemTemplate}" ItemsSource="{x:Bind recomendVM.Items, Mode=OneWay}" LoadMoreCommand="{x:Bind recomendVM.LoadMoreCommand}" SelectionMode="None">
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Margin" Value="{StaticResource ContentItemMargin}"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="Background" Value="Transparent"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
 <controls:MyAdaptiveGridView.Footer><StackPanel HorizontalAlignment="Center">
 <HyperlinkButton Content="加载更多" IsEnabled="{x:Bind recomendVM.CanRefresh, Mode=OneWay}" Command="{x:Bind recomendVM.LoadMoreCommand}" Visibility="{x:Bind recomendVM.CanLoadMore, Mode=OneWay}"/>
 <ProgressRing Width="24" IsActive="{x:Bind recomendVM.Loading, Mode=OneWay}" Visibility="{x:Bind recomendVM.Loading, Mode=OneWay}"/>
 </StackPanel></controls:MyAdaptiveGridView.Footer></controls:MyAdaptiveGridView>
<StackPanel x:Name="EmptyState" Grid.Row="2" MaxWidth="440" Margin="12" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind recomendVM.ShowEmptyStatus, Mode=OneWay}">
 <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind recomendVM.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
 <Button x:Name="EmptyRetry" Content="重试" HorizontalAlignment="Center" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind recomendVM.RefreshCommand}" IsEnabled="{x:Bind recomendVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind recomendVM.CanRetry, Mode=OneWay}"/>
 </StackPanel>

 <Border x:Name="LoadStatus" Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" Visibility="{x:Bind recomendVM.ShowInlineStatus, Mode=OneWay}">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="{x:Bind recomendVM.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
 <Button x:Name="InlineRetry" Grid.Column="1" Content="重试" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind recomendVM.RefreshCommand}" IsEnabled="{x:Bind recomendVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind recomendVM.CanRetry, Mode=OneWay}"/>
 </Grid></Border>
 <Border x:Name="LoadingPlaceholder" Grid.Row="2" Padding="24" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind recomendVM.ShowLoadingPlaceholder, Mode=OneWay}">
 <TextBlock Text="正在加载当前页面…" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
 </Border>
</Grid></Page>