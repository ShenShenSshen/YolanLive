<?xml version="1.0" ?><Page xmlns:design="using:YolanLive.WinUI.Helper" x:Class="YolanLive.WinUI.Views.SearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:YolanLive.WinUI.Controls" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}">
 <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}"><Grid x:Name="BrowseHeader" Margin="0" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><AutoSuggestBox x:Name="searchBox" VerticalAlignment="Center" PlaceholderText="搜索主播或直播间" QueryIcon="Find" QuerySubmitted="searchBox_QuerySubmitted" CornerRadius="10" FontSize="{StaticResource BodyTextSize}"/><Button x:Name="HeaderRefresh" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind searchVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/></Button></Grid></TitleBar>
 <controls:MyAdaptiveGridView Grid.Row="1" Padding="0" Margin="-8,0,-8,-8" CanLoadMore="{x:Bind searchVM.CanLoadMore, Mode=OneWay}" DataLoading="{x:Bind searchVM.Loading, Mode=OneWay}" DesiredWidth="{StaticResource GridViewDesiredWidth}" IsItemClickEnabled="True" ItemClick="MyAdaptiveGridView_ItemClick" ItemHeight="{StaticResource GridViewItemHeight}" ItemTemplate="{StaticResource RoomItemTemplate}" ItemsSource="{x:Bind searchVM.Items, Mode=OneWay}" LoadMoreCommand="{x:Bind searchVM.LoadMoreCommand}" SelectionMode="None">
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Margin" Value="{StaticResource ContentItemMargin}"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
 <Setter Property="Background" Value="Transparent"/>
 <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 <Setter Property="VerticalContentAlignment" Value="Stretch"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
 <controls:MyAdaptiveGridView.Footer><StackPanel HorizontalAlignment="Center">
 <HyperlinkButton Content="加载更多" Command="{x:Bind searchVM.LoadMoreCommand}" Visibility="{x:Bind searchVM.CanLoadMore, Mode=OneWay}"/>
 <ProgressRing Width="24" IsActive="True" Visibility="{x:Bind searchVM.Loading, Mode=OneWay}"/>
 </StackPanel></controls:MyAdaptiveGridView.Footer></controls:MyAdaptiveGridView>
 <TextBlock Style="{StaticResource BodyTextStyle}" Grid.Row="1" Text="{x:Bind searchVM.EmptyMessage, Mode=OneWay}" Margin="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Visibility="{x:Bind searchVM.IsEmpty, Mode=OneWay}"/>

 </Grid></Page>