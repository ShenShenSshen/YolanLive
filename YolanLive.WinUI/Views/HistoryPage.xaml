<?xml version="1.0" ?><Page xmlns:design="using:YolanLive.WinUI.Helper" x:Class="YolanLive.WinUI.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)" xmlns:controls="using:YolanLive.WinUI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:YolanLive.WinUI.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:YolanLive.WinUI.Models" mc:Ignorable="d" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}" xmlns:perf="using:YolanLive.WinUI.Helper">
<Page.Resources><CollectionViewSource x:Name="HistoryGroups" IsSourceGrouped="True" Source="{x:Bind historyVM.Groups, Mode=OneWay}"/></Page.Resources>

    <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}"><Grid x:Name="BrowseHeader" Margin="0" MinHeight="72" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="观看历史"/>
            <AutoSuggestBox x:Name="HeaderSearch" Grid.Column="2" design:PageDesign.Search="True" Style="{StaticResource BrowseSearchStyle}" Width="240" PlaceholderText="全平台搜索或粘贴链接" QueryIcon="Find" AutomationProperties.Name="全平台搜索或直播链接"/><Button x:Name="CompactSearch" Grid.Column="2" Style="{StaticResource ToolbarIconStyle}" Visibility="Collapsed" ToolTipService.ToolTip="全平台搜索" AutomationProperties.Name="全平台搜索" design:PageDesign.CompactSearch="True"><SymbolIcon Symbol="Find"/></Button>
            <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.CleanCommand}" IsEnabled="{x:Bind historyVM.CanRefresh, Mode=OneWay}" ToolTipService.ToolTip="清空历史" AutomationProperties.Name="清空历史"><SymbolIcon Symbol="Delete"/></Button>
                <Button x:Name="HeaderRefresh" IsEnabled="{x:Bind historyVM.CanRefresh, Mode=OneWay}" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><Grid><FontIcon Visibility="{x:Bind historyVM.CanRefresh, Mode=OneWay}" FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/><ProgressRing Width="16" Height="16" IsActive="{x:Bind historyVM.Loading, Mode=OneWay}" Visibility="{x:Bind historyVM.Loading, Mode=OneWay}"/></Grid></Button>
            </StackPanel>
        </Grid></TitleBar>
        <AutoSuggestBox x:Name="LocalFilter" Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Left" Width="240" PlaceholderText="筛选历史：主播或平台" QueryIcon="Find" Text="{x:Bind historyVM.FilterText, Mode=TwoWay}" AutomationProperties.Name="筛选当前观看历史" Style="{StaticResource BrowseSearchStyle}"/>
        <ListView x:Name="HistoryList" Grid.Row="3" Padding="0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="ls_ItemClick" ItemsSource="{Binding Source={StaticResource HistoryGroups}}">
            <ListView.GroupStyle><GroupStyle HidesIfEmpty="True"><GroupStyle.HeaderTemplate><DataTemplate x:DataType="models:HistoryGroup"><TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleStyle}" Margin="0,12,0,8"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                <Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,4"/><Setter Property="MinHeight" Value="80"/><Setter Property="CornerRadius" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
            </Style></ListView.ItemContainerStyle>
            <ListView.ItemTemplate><DataTemplate x:DataType="models:HistoryItem">
                <Grid ColumnSpacing="12">
                    <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Click="MenuFlyoutItem_Click" Icon="Delete" Text="移除"/></MenuFlyout></Grid.ContextFlyout>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <PersonPicture Width="44" Height="44" Background="{ThemeResource AppAvatarBrush}" Foreground="{ThemeResource AppSelectionTextBrush}" perf:DecodedImage.Url="{x:Bind Photo, Mode=OneWay}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind UserName, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind UserName, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind PlatformLabel, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind DisplayTime, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}"/>
                </Grid>
            </DataTemplate></ListView.ItemTemplate>
        </ListView>
<StackPanel x:Name="EmptyState" Grid.Row="3" MaxWidth="440" Margin="12" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind historyVM.ShowEmptyStatus, Mode=OneWay}">
 <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind historyVM.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
 <Button x:Name="EmptyRetry" Content="重试" HorizontalAlignment="Center" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind historyVM.RefreshCommand}" IsEnabled="{x:Bind historyVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind historyVM.CanRetry, Mode=OneWay}"/>
 </StackPanel>

    <Border x:Name="LoadStatus" Grid.Row="2" Margin="0,0,0,12" Padding="12,8" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" Visibility="{x:Bind historyVM.ShowInlineStatus, Mode=OneWay}">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="{x:Bind historyVM.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
 <Button x:Name="InlineRetry" Grid.Column="1" Content="重试" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind historyVM.RefreshCommand}" IsEnabled="{x:Bind historyVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind historyVM.CanRetry, Mode=OneWay}"/>
 </Grid></Border>
 <Border x:Name="LoadingPlaceholder" Grid.Row="3" Padding="24" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind historyVM.ShowLoadingPlaceholder, Mode=OneWay}">
 <TextBlock Text="正在加载当前页面…" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
 </Border>
</Grid>
</Page>
