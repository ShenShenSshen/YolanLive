<?xml version="1.0" ?><Page xmlns:design="using:YolanLive.WinUI.Helper" x:Class="YolanLive.WinUI.Views.HistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)" xmlns:controls="using:YolanLive.WinUI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:YolanLive.WinUI.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:YolanLive.WinUI.Models" mc:Ignorable="d" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}" xmlns:perf="using:YolanLive.WinUI.Helper">

    <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}"><Grid x:Name="BrowseHeader" Margin="0" MinHeight="48">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="观看历史"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.CleanCommand}" ToolTipService.ToolTip="清空历史" AutomationProperties.Name="清空历史" Visibility="{x:Bind historyVM.Loading, Mode=OneWay, Converter={StaticResource displayConvert}}"><SymbolIcon Symbol="Delete"/></Button>
                <Button x:Name="HeaderRefresh" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind historyVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新" Visibility="{x:Bind historyVM.Loading, Mode=OneWay, Converter={StaticResource displayConvert}}"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/></Button>
            </StackPanel>
        </Grid></TitleBar>
        <controls:MyAdaptiveGridView Grid.Row="1" Padding="0" Margin="-8,0,-8,-8" CanLoadMore="False" DesiredWidth="400" IsItemClickEnabled="True" ItemClick="ls_ItemClick" ItemHeight="96" ItemsSource="{x:Bind Path=historyVM.Items}" SelectionMode="None">
            <controls:MyAdaptiveGridView.ItemContainerStyle>
                <Style BasedOn="{StaticResource GridViewItemCornerRadiusStyle}" TargetType="GridViewItem">
                    <Setter Property="Margin" Value="{StaticResource ContentItemMargin}"/>
                    <Setter Property="Padding" Value="12"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                    <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </controls:MyAdaptiveGridView.ItemContainerStyle>
            <controls:MyAdaptiveGridView.ItemTemplate>
                <DataTemplate x:DataType="models:HistoryItem">
                    <Grid>
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="MenuFlyoutItem_Click" Icon="Delete" Text="移除"/>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <PersonPicture Width="48" Height="48" Background="{ThemeResource AppAvatarBrush}" BorderThickness="0" Foreground="{ThemeResource AppSelectionTextBrush}" perf:DecodedImage.Url="{x:Bind Path=Photo}"/>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Path=UserName}" FontSize="{StaticResource BodyTextSize}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path=UserName}"/>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}">
                                观看于<Run Text="{x:Bind Path=WatchTime}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </controls:MyAdaptiveGridView.ItemTemplate>
        </controls:MyAdaptiveGridView>
        <TextBlock Style="{StaticResource BodyTextStyle}" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Visibility="{x:Bind Path=historyVM.IsEmpty, Mode=OneWay}">
            这里还什么都没有~
        </TextBlock>

    </Grid>
</Page>