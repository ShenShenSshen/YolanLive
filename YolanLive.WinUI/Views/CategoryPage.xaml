<?xml version="1.0" ?><Page xmlns:controls="using:YolanLive.WinUI.Controls" xmlns:design="using:YolanLive.WinUI.Helper" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:YolanLive.Core.Models" xmlns:viewModels="using:YolanLive.WinUI.ViewModels" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives" xmlns:perf="using:YolanLive.WinUI.Helper" x:Class="YolanLive.WinUI.Views.CategoryPage" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}">
 <Page.Resources>
 <CornerRadius x:Key="GridViewItemCornerRadius">10</CornerRadius>
 <Style x:Key="GameGroupItemStyle" TargetType="ListViewItem">
 <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="36"/>
 <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
 <!-- A normal template keeps state and focus feedback with the content-width wrap panel. -->
 <Border x:Name="GroupRoot" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" Control.IsTemplateFocusTarget="True">
 <Border.Background><SolidColorBrush x:Name="GroupBackground" Color="Transparent"/></Border.Background>
 <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
 <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.1"/></VisualStateGroup.Transitions>
 <VisualState x:Name="Normal"><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="Transparent" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="PointerOver"><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="{ThemeResource AppHoverColor}" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="Pressed"><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="{ThemeResource AppPressedColor}" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="Selected"><VisualState.Setters><Setter Target="GroupContent.Foreground" Value="{ThemeResource CategorySelectedForegroundBrush}"/></VisualState.Setters><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="{ThemeResource CategorySelectedColor}" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="PointerOverSelected"><VisualState.Setters><Setter Target="GroupContent.Foreground" Value="{ThemeResource CategorySelectedForegroundBrush}"/></VisualState.Setters><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="{ThemeResource AppSelectionHoverColor}" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="PressedSelected"><VisualState.Setters><Setter Target="GroupContent.Foreground" Value="{ThemeResource CategorySelectedForegroundBrush}"/></VisualState.Setters><Storyboard><ColorAnimation Storyboard.TargetName="GroupBackground" Storyboard.TargetProperty="Color" To="{ThemeResource CategorySelectedColor}" Duration="0"/></Storyboard></VisualState>
 <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="GroupRoot.Opacity" Value="0.45"/></VisualState.Setters></VisualState>
 </VisualStateGroup></VisualStateManager.VisualStateGroups>
 <ContentPresenter x:Name="GroupContent" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" Foreground="{ThemeResource AppTextBrush}"/>
 </Border>
 </ControlTemplate></Setter.Value></Setter>
 <Setter Property="FontSize" Value="14"/><Setter Property="FontFamily" Value="{StaticResource NavigationFontFamily}"/></Style>

 <DataTemplate x:Key="DirectoryGameTemplate">
     <Border CornerRadius="8" Padding="8,9" Background="Transparent" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1"
             design:GameCard.Pinning="True" ToolTipService.ToolTip="{Binding Name}">
         <Grid ColumnSpacing="10">
             <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <Border Width="52" Height="52" CornerRadius="8" Background="{ThemeResource GameArtworkBrush}">
                 <Grid>
                     <FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="22" Glyph="&#xE7FC;"
                               Foreground="{ThemeResource GameArtworkForegroundBrush}"
                               Visibility="{Binding ElementName=GameImage, Path=(perf:DecodedImage.HasPicture), Converter={StaticResource displayConvert}}"/>
                     <Image x:Name="GameImage" Stretch="Uniform" perf:DecodedImage.Url="{Binding Pic}" AutomationProperties.AccessibilityView="Raw"/>
                 </Grid>
             </Border>
             <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"
                        TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
             <FontIcon Grid.Column="2" FontFamily="{StaticResource SegoeFluent}" FontSize="12" Glyph="&#xE76C;" Foreground="{ThemeResource AppSecondaryBrush}"/>
             <Button x:Name="PinGame" Grid.Column="2" Width="28" Height="28" MinWidth="0" Padding="2" Opacity="0" IsHitTestVisible="False"
                     Background="{ThemeResource AppHoverBrush}" Foreground="{ThemeResource AppAccentBrush}"><SymbolIcon Symbol="Pin"/></Button>
         </Grid>
     </Border>
 </DataTemplate>
 </Page.Resources>
 <Grid x:Name="PageLayoutRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" design:PageDesign.Insets="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16" Spacing="12">
 <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}">
     <Grid x:Name="BrowseHeader" MinHeight="64" ColumnSpacing="12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock x:Name="PageTitle" Text="找游戏" Style="{StaticResource PageTitleStyle}" TextTrimming="CharacterEllipsis"/>
         <AutoSuggestBox x:Name="HeaderSearch" Grid.Column="2" design:PageDesign.Search="True" Style="{StaticResource BrowseSearchStyle}"
             Width="240" PlaceholderText="全平台搜索或粘贴链接" QueryIcon="Find" AutomationProperties.Name="全平台搜索或直播链接"/>
         <Button x:Name="CompactSearch" Grid.Column="2" Style="{StaticResource ToolbarIconStyle}" Visibility="Collapsed"
             ToolTipService.ToolTip="全平台搜索" AutomationProperties.Name="全平台搜索" design:PageDesign.CompactSearch="True"><SymbolIcon Symbol="Find"/></Button>
         <StackPanel x:Name="HeaderActions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
             <Button x:Name="HeaderRefresh" Width="36" IsEnabled="{x:Bind categoryVM.CanRefresh, Mode=OneWay}" Style="{StaticResource ToolbarIconStyle}"
                 Command="{x:Bind categoryVM.RefreshCommand}" ToolTipService.ToolTip="刷新游戏目录" AutomationProperties.Name="刷新游戏目录">
                 <Grid><FontIcon Visibility="{x:Bind categoryVM.CanRefresh, Mode=OneWay}" FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph="&#xE72C;"/>
                 <ProgressRing Width="16" Height="16" IsActive="{x:Bind categoryVM.Loading, Mode=OneWay}" Visibility="{x:Bind categoryVM.Loading, Mode=OneWay}"/></Grid>
             </Button>
         </StackPanel>
     </Grid>
 </TitleBar>
 <Grid x:Name="CategoryTools" ColumnSpacing="16" SizeChanged="CategoryTools_SizeChanged">
 <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <ListView x:Name="GroupPicker" Padding="0" VerticalAlignment="Center" ItemsSource="{x:Bind categoryVM.Groups}" SelectedItem="{x:Bind categoryVM.SelectedGroup, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="游戏大类" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled" ItemContainerStyle="{StaticResource GameGroupItemStyle}">
 <ListView.ItemsPanel><ItemsPanelTemplate><controls:NavigationWrapPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
 <ListView.ItemTemplate><DataTemplate x:DataType="models:LiveCategory"><TextBlock Style="{StaticResource NavigationTextStyle}" Margin="0" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="None" TextWrapping="Wrap" TextAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" FontSize="{StaticResource BodyTextSize}" LineHeight="20"/></DataTemplate></ListView.ItemTemplate>
 </ListView>
 <Border x:Name="GameFilterHost" Grid.Column="1" VerticalAlignment="Center"><AutoSuggestBox x:Name="GameFilter" Text="{x:Bind categoryVM.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240" Style="{StaticResource BrowseSearchStyle}" PlaceholderText="输入游戏名" QueryIcon="Find" AutomationProperties.Name="筛选游戏"/></Border>
 <Button x:Name="CompactGameFilter" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToolbarIconStyle}" Visibility="Collapsed" ToolTipService.ToolTip="在当前平台找游戏" AutomationProperties.Name="在当前平台找游戏">
 <Button.Flyout><Flyout x:Name="GameFilterFlyout" Placement="BottomEdgeAlignedRight" Opened="GameFilterFlyout_Opened"/></Button.Flyout>
 <Grid><SymbolIcon Symbol="Find"/><Ellipse x:Name="FilterMarker" Width="5" Height="5" Fill="{ThemeResource AppAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" Visibility="Collapsed"/></Grid>
 </Button>
 </Grid>
 </StackPanel>
 <controls:MyAdaptiveGridView DesiredWidth="226" ItemHeight="88" ItemTemplate="{StaticResource DirectoryGameTemplate}" x:Name="GamesGrid" Grid.Row="2" Padding="0" Margin="-8,0,-8,-8" ItemsSource="{x:Bind categoryVM.Items}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GridView_ItemClick" ContainerContentChanging="GamesGrid_ContainerContentChanging">
 <controls:MyAdaptiveGridView.Resources>
 <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="{ThemeResource AppHoverColor}"/>
 <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="{ThemeResource AppPressedColor}"/>
 </controls:MyAdaptiveGridView.Resources>
 <controls:MyAdaptiveGridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource GridViewItemCornerRadiusStyle}">
 <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="{StaticResource ContentItemMargin}"/><Setter Property="CornerRadius" Value="10"/>
 <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
 <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource AppAccentBrush}"/>
 <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
 </Style></controls:MyAdaptiveGridView.ItemContainerStyle>
</controls:MyAdaptiveGridView>
<StackPanel x:Name="EmptyState" Grid.Row="2" MaxWidth="440" Margin="12" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.ShowEmptyStatus, Mode=OneWay}">
 <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind categoryVM.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"/>
 <Button x:Name="EmptyRetry" Content="重试" HorizontalAlignment="Center" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind categoryVM.RefreshCommand}" IsEnabled="{x:Bind categoryVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind categoryVM.CanRetry, Mode=OneWay}"/>
 </StackPanel>

 <Border x:Name="LoadStatus" Grid.Row="1" Margin="0,0,0,12" Padding="12,8" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" Visibility="{x:Bind categoryVM.ShowInlineStatus, Mode=OneWay}">
 <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <TextBlock Text="{x:Bind categoryVM.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
 <Button x:Name="InlineRetry" Grid.Column="1" Content="重试" Style="{StaticResource PageActionButtonStyle}" Command="{x:Bind categoryVM.RefreshCommand}" IsEnabled="{x:Bind categoryVM.CanRefresh, Mode=OneWay}" Visibility="{x:Bind categoryVM.CanRetry, Mode=OneWay}"/>
 </Grid></Border>
 <Border x:Name="LoadingPlaceholder" Grid.Row="2" Padding="24" CornerRadius="10" Background="{ThemeResource AppHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind categoryVM.ShowLoadingPlaceholder, Mode=OneWay}">
 <TextBlock Text="正在加载当前页面…" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextAlignment="Center"/>
 </Border>
</Grid></Page>
