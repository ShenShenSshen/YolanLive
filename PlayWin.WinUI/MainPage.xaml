<?xml version="1.0" ?><Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:PlayWin.WinUI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" x:Class="PlayWin.WinUI.MainPage" mc:Ignorable="d">
    <Page.Resources>
        <Thickness x:Key="NavigationViewContentPresenterMargin">0,0,0,0</Thickness>
        <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
        <x:Double x:Key="NavigationViewItemOnLeftIconBoxHeight">20</x:Double>
        <Style TargetType="FontIcon">
            <Setter Property="FontSize" Value="20"/>
        </Style>
        <Style TargetType="muxc:NavigationViewItem">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontFamily" Value="{StaticResource NavigationFontFamily}"/><Setter Property="FontSize" Value="{StaticResource NavigationTextSize}"/></Style>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource AppAccentColor}"/><SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource AppTextColor}"/><SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource AppTextColor}"/><SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="{ThemeResource AppTextColor}"/><SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource AppHoverColor}"/><SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="{ThemeResource AppPressedColor}"/><SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource AppSelectionColor}"/><SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource AppSelectionHoverColor}"/><SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="{ThemeResource AppSelectionColor}"/><SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource AppSelectionTextColor}"/><SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource AppSelectionTextColor}"/><SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="{ThemeResource AppSelectionTextColor}"/><SolidColorBrush x:Key="TopNavigationViewItemBackgroundSelected" Color="{ThemeResource AppSelectionColor}"/><SolidColorBrush x:Key="TopNavigationViewItemForegroundSelected" Color="{ThemeResource AppSelectionTextColor}"/><SolidColorBrush x:Key="TopNavigationViewItemForegroundSelectedPointerOver" Color="{ThemeResource AppSelectionTextColor}"/><SolidColorBrush x:Key="TopNavigationViewItemForegroundSelectedPressed" Color="{ThemeResource AppSelectionTextColor}"/></Page.Resources>
    <Grid>


        <muxc:NavigationView FontFamily="{StaticResource NavigationFontFamily}" FontSize="{StaticResource NavigationTextSize}" x:Name="navigationView" Background="{ThemeResource ChromeSurfaceBrush}" IsTitleBarAutoPaddingEnabled="False" IsBackButtonVisible="Collapsed" IsPaneOpen="False" IsSettingsVisible="true" Loaded="navigationView_Loaded" CompactPaneLength="56" OpenPaneLength="208" PaneOpened="NavigationView_PaneStateChanged" PaneClosed="NavigationView_PaneStateChanged" PaneDisplayMode="Left" SelectionChanged="NavigationView_SelectionChanged" ItemInvoked="NavigationView_ItemInvoked">
            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="searchBox" FontFamily="{StaticResource ContentControlThemeFontFamily}" AutomationProperties.Name="搜索主播或直播链接" PlaceholderText="搜索主播或粘贴链接" QueryIcon="Find" QuerySubmitted="searchBox_QuerySubmitted" CornerRadius="10" FontSize="14"/>
            </muxc:NavigationView.AutoSuggestBox>


            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="首页" IsSelected="True" Tag="RecomendPage" ToolTipService.ToolTip="首页">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph=""/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="RandomLiveItem" Content="随便逛逛" Tag="RandomLive" SelectsOnInvoked="False" ToolTipService.ToolTip="从四个平台随机看游戏直播" AutomationProperties.Name="随便逛逛">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph=""/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="分类" Tag="CategoryPage" ToolTipService.ToolTip="分类">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph=""/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="关注" Tag="FavoritePage" ToolTipService.ToolTip="关注">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph=""/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="历史" Tag="HistoryPage" ToolTipService.ToolTip="历史">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph=""/>
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                
                <!--<muxc:NavigationViewItem Content="设置" Tag="SettingsPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SegoeFluent}" Glyph="&#xE115;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>-->
            </muxc:NavigationView.MenuItems>

            <Frame x:Name="frame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"/>
        </muxc:NavigationView>

    </Grid>
</Page>