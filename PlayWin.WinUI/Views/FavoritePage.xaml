<?xml version="1.0" ?><Page xmlns:design="using:PlayWin.WinUI.Helper" x:Class="PlayWin.WinUI.Views.FavoritePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Windows10version1809="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract, 7)" xmlns:controls="using:PlayWin.WinUI.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:PlayWin.WinUI.Views" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="using:PlayWin.WinUI.Models" mc:Ignorable="d" FontFamily="{StaticResource ContentControlThemeFontFamily}" FontSize="{StaticResource BodyTextSize}" Foreground="{ThemeResource AppTextBrush}" xmlns:perf="using:PlayWin.WinUI.Helper">

    <Grid x:Name="PageLayoutRoot" design:PageDesign.Insets="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="BrowserTitleBar" Style="{StaticResource BrowserTitleBarStyle}"><Grid x:Name="BrowseHeader" Margin="0" MinHeight="48">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="PageTitle" Margin="0,0,8,0" Style="{StaticResource PageTitleStyle}" Text="我的关注"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ManageFavorites" Click="ManageFavorites_Click" Style="{StaticResource PageActionButtonStyle}">管理全部关注</Button>
                <Grid Width="36" Height="36">
                    <Button x:Name="HeaderRefresh" Style="{StaticResource ToolbarIconStyle}" Command="{x:Bind favoriteVM.RefreshCommand}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新" Visibility="{x:Bind favoriteVM.LoaddingLiveStatus, Mode=OneWay, Converter={StaticResource displayConvert}}"><FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/></Button>
                    <ProgressRing Width="20" Height="20" IsActive="True" Visibility="{x:Bind favoriteVM.LoaddingLiveStatus, Mode=OneWay}"/>
                </Grid>
                <Button x:Name="FavoriteMore" Style="{StaticResource ToolbarIconStyle}" ToolTipService.ToolTip="更多关注操作" AutomationProperties.Name="更多关注操作">
                    <FontIcon FontFamily="{StaticResource SegoeFluent}" FontSize="16" Glyph=""/>
                    <Button.Flyout><MenuFlyout>
                        <MenuFlyoutItem x:Name="ImportFavorites" Text="导入列表" Command="{x:Bind favoriteVM.InputCommand}"/>
                        <MenuFlyoutItem x:Name="ExportFavorites" Text="导出列表" Command="{x:Bind favoriteVM.OutputCommand}"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="FavoriteHelp" Text="使用说明" Command="{x:Bind favoriteVM.TipCommand}"/>
                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid></TitleBar>
        <Grid Grid.Row="1">
            <controls:MyAdaptiveGridView Padding="0" Margin="-8,0,-8,-8" CanLoadMore="False" DesiredWidth="400" IsItemClickEnabled="True" ItemClick="ls_ItemClick" ItemHeight="96" ItemsSource="{x:Bind Path=favoriteVM.Items, Mode=OneWay}" SelectionMode="None">
                <controls:MyAdaptiveGridView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource GridViewItemCornerRadiusStyle}" TargetType="GridViewItem">
                        <Setter Property="Margin" Value="{StaticResource ContentItemMargin}"/>
                        <Setter Property="Padding" Value="12"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                        <Setter Property="Background" Value="{ThemeResource ButtonBackground}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                    </Style>
                </controls:MyAdaptiveGridView.ItemContainerStyle>
                <controls:MyAdaptiveGridView.ItemTemplate>
                    <DataTemplate x:DataType="models:FavoriteItem">
                        <Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="MenuFlyoutItem_Click" Icon="Delete" Text="移除"/>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PersonPicture Width="48" Height="48" Background="{ThemeResource AppAvatarBrush}" BorderThickness="0" Foreground="{ThemeResource AppSelectionTextBrush}" perf:DecodedImage.Url="{x:Bind Path=Photo}"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="{x:Bind Path=UserName}" FontSize="{StaticResource BodyTextSize}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path=UserName}"/>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Text="{x:Bind Path=SiteName}"/>
                            </StackPanel>
                            <StackPanel Margin="12,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{x:Bind Path=LiveStatus, Mode=OneWay}" Grid.Column="2">
                                <Ellipse Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center" Fill="{ThemeResource AppAccentBrush}"/>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" FontSize="{StaticResource SecondaryTextSize}" Foreground="{ThemeResource AppAccentBrush}" Text="直播中" Visibility="{x:Bind Path=LiveStatus, Mode=OneWay}"/>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </controls:MyAdaptiveGridView.ItemTemplate>
            </controls:MyAdaptiveGridView>
            <TextBlock Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource ReadableSecondaryTextBrush}" Visibility="{x:Bind Path=favoriteVM.IsEmpty, Mode=OneWay}">
                <Run Text="{x:Bind favoriteVM.EmptyMessage, Mode=OneWay}"/>
            </TextBlock>


        </Grid>
    </Grid>
</Page>